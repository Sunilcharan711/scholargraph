# Copy to .env in the repository root. Never commit populated credentials.
LOG_LEVEL=INFO
# Native backend: postgresql+psycopg://scholargraph:YOUR_PASSWORD@localhost:5432/scholargraph
# Compose supplies its internal connection URL using POSTGRES_PASSWORD below.
DATABASE_URL=
POSTGRES_PASSWORD=
LLM_PROVIDER=
LLM_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# A commit hash is recommended for reproducibility; resolved hash is stored with vectors.
EMBEDDING_REVISION=main
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=data/models
# Set true after downloading to run without network access.
EMBEDDING_LOCAL_FILES_ONLY=false
CHAT_MODEL=
RERANKER_MODEL=
# Relative paths resolve against the repository root, regardless of working directory.
UPLOAD_DIR=data/uploads
MAX_FILE_SIZE_MB=25
MAX_PDF_PAGES=500
MAX_EXTRACTED_CHARS=2000000
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
